# Documentation des variables du runtime Supabase ; npm test ne charge pas ce fichier.
# Valeurs fournies par le runtime de la fonction :
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secrets à configurer côté serveur uniquement :
# (l'authentification des appelants ne passe plus par une variable : un jeton
#  par service, stocké en base sous forme d'empreinte — voir le README)
ARC_BASE=
ARC_TOKEN=
# Facultatif, valeur par défaut lexpress :
ARC_SITE=lexpress
# Facultatif, valeur par défaut https://articles.lexpress.fr :
GIFT_LINK_BASE=https://articles.lexpress.fr
