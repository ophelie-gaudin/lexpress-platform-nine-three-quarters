# Documentation des variables du runtime Supabase ; npm test ne charge pas ce fichier.
# Valeurs fournies par le runtime de la fonction :
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secrets à configurer côté serveur uniquement :
# (l'authentification des appelants ne passe plus par une variable : un jeton
#  par service, stocké en base sous forme d'empreinte — voir le README)
ARC_BASE=
ARC_TOKEN=
# Facultatif, valeur par défaut lexpress :
ARC_SITE=lexpress
# Facultatif, valeur par défaut https://articles.lexpress.fr :
GIFT_LINK_BASE=https://articles.lexpress.fr

# ── L'interface web (Vercel). UNE SEULE variable, côté serveur. Le déploiement ne détient AUCUN jeton
#    de service : chaque personne entre le sien, et il est scellé dans un cookie chiffré.
#    Voir interface/README.md.
# La clé qui scelle les cookies de session — `openssl rand -hex 32` :
INTERFACE_SECRET_SESSION=
# La clé d'accès partagée, première barrière — `openssl rand -base64 18`, 16 caractères au minimum :
INTERFACE_CLE_ACCES=
# Facultatif : par défaut, l'interface appelle la fonction de production.
GIFT_API_URL=
